{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verge-tv-trailer-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "https://chigala.github.io",
    "CINESRC_ENABLED": "0"
  }
}
